# Use APP_ENV=local on WAMP/MAMP to relax TLS for outbound API calls.
# Any other value (production, staging) keeps full TLS verification.
APP_ENV=local
APP_NAME="TagVerity"
APP_VERSION=1.0.0
APP_URL=http://localhost/gtm-auditor

# Database
DB_HOST=localhost
DB_NAME=gtm_auditor
DB_USER=root
DB_PASS=

# Encryption — AES-256 key for storing Google OAuth refresh tokens at rest.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
TOKEN_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64

# Google OAuth 2.0
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Stripe — billing
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Mail (SendGrid SMTP)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.REPLACE_ME
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="TagVerity"

# Headless Crawl Microservice (Phase 2)
CRAWL_SERVICE_URL=http://localhost:3100
CRAWL_SERVICE_SECRET=REPLACE_ME_SHARED_SECRET

# Developer tooling
DEVELOPER_MIGRATION_KEY=REPLACE_ME
