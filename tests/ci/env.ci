# CI environment for GitHub Actions. Copied to .env by .github/workflows/ci.yml.
# Every key from .env.example is present; keys the test suite does not need are empty.
# TOKEN_ENCRYPTION_KEY is left empty here and generated per run by the workflow.
APP_ENV=testing
APP_NAME=TagVerity
APP_VERSION=
APP_URL=http://localhost

# Database
DB_HOST=127.0.0.1
DB_NAME=tagverity_test
DB_USER=root
DB_PASS=root

# Encryption
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Headless Crawl Microservice
CRAWL_SERVICE_URL=
CRAWL_SERVICE_SECRET=
SITE_SCAN_CA_BUNDLE=

# Developer tooling
DEVELOPER_MIGRATION_KEY=
