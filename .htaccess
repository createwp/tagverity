Options -Indexes

# Deny by default: only root pages, api/ and assets/ are publicly reachable.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block any path segment starting with a dot (.git/, .env, .remember/, .claude/, ...)
    RewriteRule (^|/)\. - [F,L]

    # Block internal directories
    RewriteRule ^(vendor|tests|docs|logs|storage|sql|src|includes|cron|node_modules)(/|$) - [F,L]

    # Block Markdown documents
    RewriteRule \.md$ - [F,L]

    # Block Composer manifests
    RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

# Protect .env files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
